{
  "name": "netsight",
  "version": "0.1.0",
  "private": true,
  "description": "NetSight: report lost or abandoned fishing gear. Website plus the boat-mode mobile app (Capacitor).",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "build:local": "NETSIGHT_LOCAL=1 node scripts/build-www.mjs",
    "web": "node scripts/build-www.mjs && node scripts/serve.mjs",
    "web:local": "NETSIGHT_LOCAL=1 node scripts/build-www.mjs && node scripts/serve.mjs",
    "sync": "node scripts/build-www.mjs && cap sync",
    "android": "node scripts/build-www.mjs && cap sync android && cap open android",
    "ios": "node scripts/build-www.mjs && cap sync ios && cap open ios",
    "site": "node scripts/build-site.mjs && DIR=www-site PORT=5174 node scripts/serve.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.3",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/haptics": "8.0.2",
    "@supabase/supabase-js": "2.119.2",
    "leaflet": "1.9.4",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/cli": "8.6.3",
    "@capacitor/ios": "8.6.3",
    "esbuild": "0.28.2"
  }
}
